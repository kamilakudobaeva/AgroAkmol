# Госстатистика Акмолинской области — xlsx скачивается вручную со stat.gov.kz
# (https://stat.gov.kz/ru/region/akmola/dynamic-tables/1485/) и кладётся в:
#   data/raw/government/akmola_yield.xlsx

# AI-чат: провайдер и ключ (LLM должен быть доступен через OpenAI-совместимый API —
# так работают OpenAI, DeepSeek, и локальные vLLM/Ollama)
CHAT_LLM_PROVIDER=deepseek
CHAT_LLM_MODEL=deepseek-chat
CHAT_LLM_API_KEY=your_llm_api_key_here
CHAT_LLM_BASE_URL=https://api.deepseek.com

# Погода/почва/NDVI — все публичные источники без ключа (Open-Meteo, NASA POWER,
# SoilGrids, Planetary Computer), ключи не нужны.
